<?xml version="1.0" encoding="UTF-8"?>
<!-- One process for an application under any domain of the knowledge model. It knows no domain:
     the service task decides with the model (CheckApplication); what is missing goes back to the
     applicant; each next step that the model derives becomes a task of the office; then a person
     decides. The names are in English; the app shows them in the user's language. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="https://example.org/eligibility">
  <process id="application" name="Application" isExecutable="true">
    <startEvent id="submitted" name="Application submitted" flowable:initiator="applicant"/>
    <sequenceFlow id="toCheck" sourceRef="submitted" targetRef="check"/>

    <serviceTask id="check" name="Decide with the knowledge model" flowable:delegateExpression="${checkApplication}"/>
    <sequenceFlow id="toRuling" sourceRef="check" targetRef="ruling"/>

    <exclusiveGateway id="ruling" name="What does the model decide?"/>
    <sequenceFlow id="incomplete" name="incomplete" sourceRef="ruling" targetRef="complete">
      <conditionExpression>${!missing.isEmpty()}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="notAllowed" name="refused" sourceRef="ruling" targetRef="refused">
      <conditionExpression>${missing.isEmpty() &amp;&amp; !allowed}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="isAllowed" name="allowed" sourceRef="ruling" targetRef="steps">
      <conditionExpression>${allowed}</conditionExpression>
    </sequenceFlow>
    <endEvent id="refused" name="Refused by the rules"/>

    <userTask id="complete" name="Complete the application" flowable:assignee="${applicant}"/>
    <sequenceFlow id="completed" sourceRef="complete" targetRef="check"/>

    <!-- One task for each next step of the model, in parallel. -->
    <userTask id="steps" name="Check a next step" flowable:candidateGroups="office" flowable:dueDate="P3D">
      <extensionElements>
        <flowable:taskListener event="create" expression="${task.setVariableLocal('nextStep', nextStep)}"/>
      </extensionElements>
      <multiInstanceLoopCharacteristics isSequential="false" flowable:collection="nextSteps" flowable:elementVariable="nextStep"/>
    </userTask>
    <sequenceFlow id="toDecide" sourceRef="steps" targetRef="decide"/>

    <userTask id="decide" name="Decide on the application" flowable:candidateGroups="office" flowable:dueDate="P5D"/>
    <sequenceFlow id="toDecision" sourceRef="decide" targetRef="decision"/>

    <exclusiveGateway id="decision" name="Decision"/>
    <sequenceFlow id="approve" name="approve" sourceRef="decision" targetRef="approved">
      <conditionExpression>${decision == 'approve'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="reject" name="reject" sourceRef="decision" targetRef="rejected">
      <conditionExpression>${decision == 'reject'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="return" name="return" sourceRef="decision" targetRef="complete">
      <conditionExpression>${decision == 'return'}</conditionExpression>
    </sequenceFlow>
    <endEvent id="approved" name="Approved"/>
    <endEvent id="rejected" name="Rejected"/>
  </process>

  <bpmndi:BPMNDiagram id="diagram">
    <bpmndi:BPMNPlane bpmnElement="application">
      <bpmndi:BPMNShape bpmnElement="submitted"><dc:Bounds x="42" y="164" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="0" y="205" width="120" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="check"><dc:Bounds x="120" y="142" width="110" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="ruling" isMarkerVisible="true"><dc:Bounds x="280" y="157" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="complete"><dc:Bounds x="250" y="20" width="110" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="refused"><dc:Bounds x="287" y="290" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="245" y="331" width="120" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="steps"><dc:Bounds x="390" y="142" width="110" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="decide"><dc:Bounds x="550" y="142" width="110" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="decision" isMarkerVisible="true"><dc:Bounds x="710" y="157" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="approved"><dc:Bounds x="820" y="164" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="778" y="205" width="120" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="rejected"><dc:Bounds x="717" y="290" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="675" y="331" width="120" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge bpmnElement="toCheck"><di:waypoint x="78" y="182"/><di:waypoint x="120" y="182"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="toRuling"><di:waypoint x="230" y="182"/><di:waypoint x="280" y="182"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="incomplete"><di:waypoint x="305" y="157"/><di:waypoint x="305" y="100"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="notAllowed"><di:waypoint x="305" y="207"/><di:waypoint x="305" y="290"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="isAllowed"><di:waypoint x="330" y="182"/><di:waypoint x="390" y="182"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="completed"><di:waypoint x="250" y="60"/><di:waypoint x="175" y="60"/><di:waypoint x="175" y="142"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="toDecide"><di:waypoint x="500" y="182"/><di:waypoint x="550" y="182"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="toDecision"><di:waypoint x="660" y="182"/><di:waypoint x="710" y="182"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="approve"><di:waypoint x="760" y="182"/><di:waypoint x="820" y="182"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="reject"><di:waypoint x="735" y="207"/><di:waypoint x="735" y="290"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="return"><di:waypoint x="735" y="157"/><di:waypoint x="735" y="60"/><di:waypoint x="360" y="60"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
