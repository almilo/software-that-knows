# A shared module: the articles of the WEFV (SR 831.411) that the domains cite (prov:wasDerivedFrom), with
# their labels in the abbreviations of each language. Checked against the consolidated text on fedlex.admin.ch
# on 4 October 2026 (in force since 1 October 2017).
# The comments are short summaries in English, not official texts.

@prefix law:  <https://example.org/ch-law#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://example.org/ch-law/wefv> a owl:Ontology ;
  rdfs:label "WEFV (SR 831.411)" .

law:WEFV a prov:Entity ;
  rdfs:label "WEFV (SR 831.411)"@en , "WEFV (SR 831.411)"@de , "OEPL (RS 831.411)"@fr , "OPPA (RS 831.411)"@it ;
  rdfs:comment "Ordinance on the Promotion of Home Ownership with Occupational Pension Funds." .

law:WEFV-1-1 a prov:Entity ; prov:wasDerivedFrom law:WEFV ;
  rdfs:label "WEFV Art. 1 para. 1"@en , "WEFV Art. 1 Abs. 1"@de , "OEPL art. 1 al. 1"@fr , "OPPA art. 1 cpv. 1"@it ;
  rdfs:comment "Allowed purposes: buying or building a home, participations in home ownership, repaying mortgage loans." .
law:WEFV-1-2 a prov:Entity ; prov:wasDerivedFrom law:WEFV ;
  rdfs:label "WEFV Art. 1 para. 2"@en , "WEFV Art. 1 Abs. 2"@de , "OEPL art. 1 al. 2"@fr , "OPPA art. 1 cpv. 2"@it ;
  rdfs:comment "Pension money can be used for only one property at a time." .
law:WEFV-2-1 a prov:Entity ; prov:wasDerivedFrom law:WEFV ;
  rdfs:label "WEFV Art. 2 para. 1"@en , "WEFV Art. 2 Abs. 1"@de , "OEPL art. 2 al. 1"@fr , "OPPA art. 2 cpv. 1"@it ;
  rdfs:comment "Allowed homes: an apartment or a single-family house." .
law:WEFV-2-2 a prov:Entity ; prov:wasDerivedFrom law:WEFV ;
  rdfs:label "WEFV Art. 2 para. 2"@en , "WEFV Art. 2 Abs. 2"@de , "OEPL art. 2 al. 2"@fr , "OPPA art. 2 cpv. 2"@it ;
  rdfs:comment "Allowed forms: sole ownership, co-ownership (for example condominium), joint ownership with the spouse or registered partner, independent and permanent building right." .
law:WEFV-3 a prov:Entity ; prov:wasDerivedFrom law:WEFV ;
  rdfs:label "WEFV Art. 3"@en , "WEFV Art. 3"@de , "OEPL art. 3"@fr , "OPPA art. 3"@it ;
  rdfs:comment "Allowed participations: shares in a housing cooperative, shares in a tenants' company, participating loans to a non-profit housing developer." .
law:WEFV-4 a prov:Entity ; prov:wasDerivedFrom law:WEFV ;
  rdfs:label "WEFV Art. 4"@en , "WEFV Art. 4"@de , "OEPL art. 4"@fr , "OPPA art. 4"@it ;
  rdfs:comment "Own use: the person uses the home where they live or usually stay. Letting is allowed while the person proves that they cannot use it for a time." .
law:WEFV-5-1 a prov:Entity ; prov:wasDerivedFrom law:WEFV ;
  rdfs:label "WEFV Art. 5 para. 1"@en , "WEFV Art. 5 Abs. 1"@de , "OEPL art. 5 al. 1"@fr , "OPPA art. 5 cpv. 1"@it ;
  rdfs:comment "The minimum withdrawal is CHF 20 000." .
law:WEFV-5-2 a prov:Entity ; prov:wasDerivedFrom law:WEFV ;
  rdfs:label "WEFV Art. 5 para. 2"@en , "WEFV Art. 5 Abs. 2"@de , "OEPL art. 5 al. 2"@fr , "OPPA art. 5 cpv. 2"@it ;
  rdfs:comment "The minimum does not apply to shares in housing cooperatives and similar participations, nor to claims against vested benefits institutions." .
law:WEFV-5-3 a prov:Entity ; prov:wasDerivedFrom law:WEFV ;
  rdfs:label "WEFV Art. 5 para. 3"@en , "WEFV Art. 5 Abs. 3"@de , "OEPL art. 5 al. 3"@fr , "OPPA art. 5 cpv. 3"@it ;
  rdfs:comment "A withdrawal can be asked for every 5 years." .
law:WEFV-5-4 a prov:Entity ; prov:wasDerivedFrom law:WEFV ;
  rdfs:label "WEFV Art. 5 para. 4"@en , "WEFV Art. 5 Abs. 4"@de , "OEPL art. 5 al. 4"@fr , "OPPA art. 5 cpv. 4"@it ;
  rdfs:comment "Over 50, at most the higher of: a. the vested benefit at 50, plus repayments and minus withdrawals and pledge enforcements for the home since then; b. half of the difference between the vested benefit at the time of the withdrawal and the vested benefit already used for the home." .
law:WEFV-6-1 a prov:Entity ; prov:wasDerivedFrom law:WEFV ;
  rdfs:label "WEFV Art. 6 para. 1"@en , "WEFV Art. 6 Abs. 1"@de , "OEPL art. 6 al. 1"@fr , "OPPA art. 6 cpv. 1"@it ;
  rdfs:comment "The fund pays at the latest 6 months after the person asked for the withdrawal." .
law:WEFV-6a a prov:Entity ; prov:wasDerivedFrom law:WEFV ;
  rdfs:label "WEFV Art. 6a"@en , "WEFV Art. 6a"@de , "OEPL art. 6a"@fr , "OPPA art. 6a"@it ;
  rdfs:comment "If its regulations provide for it, an underfunded fund can limit a withdrawal that repays a mortgage loan in time and amount, or refuse it; only for the duration of the underfunding." .
law:WEFV-10 a prov:Entity ; prov:wasDerivedFrom law:WEFV ;
  rdfs:label "WEFV Art. 10"@en , "WEFV Art. 10"@de , "OEPL art. 10"@fr , "OPPA art. 10"@it ;
  rdfs:comment "The person proves that the conditions are met." .
law:WEFV-16 a prov:Entity ; prov:wasDerivedFrom law:WEFV ;
  rdfs:label "WEFV Art. 16"@en , "WEFV Art. 16"@de , "OEPL art. 16"@fr , "OPPA art. 16"@it ;
  rdfs:comment "Shares bought with pension money are deposited with the pension fund." .
