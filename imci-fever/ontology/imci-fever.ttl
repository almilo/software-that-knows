# ---------------------------------------------------------------------------
# 6. Words
# ---------------------------------------------------------------------------
# How a health worker's note states each field: the words that need judgement. Code adds the
# deterministic ones: each field's own label (sh:name) and, for the form, the definition of its DAK
# data element (generator/join-dak.ts). The words below are synonyms, words for absence, words for
# values and abbreviations. The words directly below were written by a coding agent in one session,
# before the extract-words skill existed (.claude/skills/extract-words in the repository); the skill
# adds its words below them, each run under its own header, after consensus and automatic checks.

imci:convulsingNow skos:altLabel "convulsing right now", "fitting now", "seizing now" .
imci:convulsions skos:altLabel "convulsion", "convulsions", "convulsed", "fit", "fits", "seizure", "seizures" ;
  imci:absentLabel "no convulsions", "no convulsion", "no fits", "no seizures" .
imci:convulsionCount skos:altLabel "convulsion", "convulsions", "fit", "fits", "seizure", "seizures" ;
  imci:valueLabel [ imci:value "one" ; skos:altLabel "one", "once", "a single", "a convulsion", "a fit", "a seizure" ] ,
                  [ imci:value "two or more" ; skos:altLabel "two", "twice", "three", "several", "multiple", "repeated" ] .
imci:convulsionLong skos:altLabel "15 minutes", "long convulsion", "prolonged", "lasted" ;
  imci:absentLabel "less than a minute" .
imci:lethargic skos:altLabel "lethargic", "lethargy", "unconscious", "abnormally sleepy", "very sleepy", "difficult to wake", "difficult to awaken", "unresponsive" ;
  imci:absentLabel "not lethargic" .
imci:notAbleToDrink skos:altLabel "not able to drink", "unable to drink", "cannot drink", "can't drink", "does not drink", "not drinking", "not able to breastfeed", "unable to breastfeed", "not breastfeeding" ;
  imci:absentLabel "drinks well", "drinking well", "drinks normally", "able to drink" .
imci:vomitsEverything skos:altLabel "vomits everything", "vomits all", "keeps nothing down", "cannot keep anything down" ;
  imci:absentLabel "no vomiting", "not vomiting", "does not vomit" .
imci:oralFluidTest skos:altLabel "oral fluid test", "fluid test" ;
  imci:valueLabel [ imci:value "completely unable to drink" ; skos:altLabel "completely unable to drink" ] ,
                  [ imci:value "vomits immediately or everything" ; skos:altLabel "vomits immediately" ] ,
                  [ imci:value "drinks poorly" ; skos:altLabel "drinks poorly" ] ,
                  [ imci:value "drinks eagerly or thirstily" ; skos:altLabel "drinks eagerly", "drinks thirstily" ] ,
                  [ imci:value "drinks normally" ; skos:altLabel "drinks normally" ] ,
                  [ imci:value "unable to do the test" ; skos:altLabel "unable to do the test" ] .
imci:feverReported skos:altLabel "fever", "feverish", "febrile", "high temperature", "hot" ;
  imci:absentLabel "no fever", "not feverish", "afebrile" .
imci:axillaryTemperature skos:altLabel "axillary", "under the arm", "armpit" .
imci:rectalTemperature skos:altLabel "rectal", "rectally" .
imci:thermometerNotAvailable skos:altLabel "no thermometer", "without a thermometer", "thermometer not available" .
imci:hotToTouch skos:altLabel "hot to the touch", "feels hot", "warm to touch" .
imci:malariaRisk skos:altLabel "malaria risk", "risk area", "malaria area" ;
  imci:valueLabel [ imci:value "high" ; skos:altLabel "high risk", "high malaria", "high transmission" ] ,
                  [ imci:value "low" ; skos:altLabel "low risk", "low malaria", "low transmission" ] ,
                  [ imci:value "no" ; skos:altLabel "no malaria risk", "no malaria", "no risk", "malaria free" ] .
imci:travelToHighRiskArea skos:altLabel "travel", "travelled", "traveled", "trip", "visited" ;
  imci:absentLabel "no travel", "not travelled", "not traveled", "did not travel" .
imci:obviousCause skos:altLabel "obvious cause", "other cause", "cause of fever" ;
  imci:absentLabel "no obvious cause", "no other cause" .
imci:feverDuration skos:altLabel "fever", "feverish", "febrile", "hot" ;
  imci:valueLabel [ imci:value "7 days or less" ; imci:maxDays 7 ] ,
                  [ imci:value "more than 7 days" ; imci:minDays 8 ] .
imci:feverEveryDay skos:altLabel "every day", "daily", "each day" ;
  imci:absentLabel "not every day" .
imci:stiffNeck skos:altLabel "neck stiffness", "neck stiff" ;
  imci:absentLabel "no stiff neck", "supple neck" .
imci:refusalToUseLimb skos:altLabel "refuses to use", "refusal to use", "does not use", "not using", "limp", "limping" .
imci:warmTenderJoint skos:altLabel "swollen", "swelling", "tender", "warm joint", "joint" .
imci:painPassingUrine skos:altLabel "passing urine", "passes urine", "urination", "urinating", "dysuria" .
imci:cough skos:altLabel "coughing" ;
  imci:absentLabel "no cough" .
imci:runnyNose skos:altLabel "running nose", "nasal discharge" ;
  imci:absentLabel "no runny nose" .
imci:redEyes skos:altLabel "red eye", "eyes are red" ;
  imci:absentLabel "no red eyes" .
imci:otherSevereClassification skos:altLabel "severe classification", "severe pneumonia", "mastoiditis", "severe acute malnutrition" .
imci:malariaTest skos:altLabel "malaria test", "rapid test", "rdt", "smear", "test" ;
  imci:valueLabel [ imci:value "positive" ; skos:altLabel "positive" ] ,
                  [ imci:value "negative" ; skos:altLabel "negative" ] ,
                  [ imci:value "unknown" ; skos:altLabel "not done", "not available", "no test", "unavailable", "invalid" ] .
imci:highParasiteDensity skos:altLabel "parasite density", "parasite count", "parasitaemia", "parasitemia" .
imci:skinProblem skos:altLabel "rash", "skin" ;
  imci:valueLabel [ imci:value "generalized" ; skos:altLabel "generalized", "generalised", "widespread" ] ,
                  [ imci:value "localized" ; skos:altLabel "localized", "localised" ] ,
                  [ imci:value "none" ; skos:altLabel "no rash", "no skin problem" ] .
imci:measlesRash skos:altLabel "like measles", "measles like" .
imci:measlesRecent skos:altLabel "had measles", "measles within", "measles in the past" .
imci:mouthUlcers skos:altLabel "mouth ulcers", "mouth sores", "oral sores", "ulcers", "thrush" ;
  imci:valueLabel [ imci:value "none" ; skos:altLabel "no ulcers", "no mouth ulcers" ] ,
                  [ imci:value "oral thrush" ; skos:altLabel "thrush", "oral thrush" ] ,
                  [ imci:value "deep and extensive" ; skos:altLabel "deep", "extensive" ] ,
                  [ imci:value "not deep and extensive" ; skos:altLabel "not deep", "shallow" ] .
imci:pusFromEye skos:altLabel "pus", "eye discharge", "discharge from the eye" .
imci:corneaClouding skos:altLabel "cornea clouding", "cloudy cornea", "corneal clouding" ;
  imci:absentLabel "cornea is clear", "clear cornea" .
imci:vitaminARecent skos:altLabel "vitamin a" .

