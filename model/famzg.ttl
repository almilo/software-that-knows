    rdfs:label "Informationsstelle AHV/IV: Update «Sozialversicherungen in der Schweiz», Stand 1. Januar 2026 (changes 2025: minimum old-age pension CHF 1,260, maximum CHF 2,520 a month; changes 2026: no new pension amounts)"@en ;
    dcterms:publisher "Informationsstelle AHV/IV" ;
    dcterms:date "2026-01-01"^^xsd:date ;
    rdfs:seeAlso <https://www.shop.ahv-iv.ch/data/docs/de/82816/Update-%C2%ABSozialversicherungen-in-der-Schweiz%C2%BB-Stand-1.-Januar-2026.pdf> .

fz:BsvFamilyAllowances a dcterms:BibliographicResource ;
    rdfs:label "Federal Social Insurance Office (BSV): Zulagen für Familien (minimum earned income CHF 7,560 a year, CHF 630 a month)"@en ;
    dcterms:publisher "Bundesamt für Sozialversicherungen BSV" ;
    rdfs:seeAlso <https://www.bsv.admin.ch/de/zulagen-fuer-familien> .

# =========================================================================
# Interpretations
# =========================================================================

fz:I-age a stk:Interpretation ;
    rdfs:label "I1 Completed year of age"@en ;
    rdfs:comment "«Das n. Altersjahr vollenden» means the n-th birthday. «Der Monat, in dem das Kind das n. Altersjahr vollendet» is the month of the n-th birthday."@en .

fz:I-reference-date a stk:Interpretation ;
    rdfs:label "I2 Reference date"@en ;
    rdfs:comment "The model gives the allowance that applies in the month of the date of the application. The answers describe the situation at that date."@en .

fz:I-latest-end a stk:Interpretation ;
    rdfs:label "I3 Latest end of the education allowance"@en ;
    rdfs:comment "The end of the education is not known at the date of the application. The model gives the latest end: the end of the month of the 25th birthday."@en .

fz:I-minimum-income a stk:Interpretation ;
    rdfs:label "I4 Minimum income"@en ;
    rdfs:comment "«Halber jährlicher Betrag der minimalen vollen Altersrente» = 0.5 x 12 x the monthly minimum full old-age pension. The BSV gives the same result (CHF 7,560)."@en ;
    dcterms:source fz:BsvFamilyAllowances .

fz:I-income-question a stk:Interpretation ;
    rdfs:label "I5 Annual income"@en ;
    rdfs:comment "The model asks for the annual earned income on which the applicant pays AHV contributions, and compares it with the minimum income of Art. 13 para. 3."@en .

fz:I-maximum-taxable a stk:Interpretation ;
    rdfs:label "I6 Income limit for non-employed persons"@en ;
    rdfs:comment "«Anderthalbfacher Betrag einer maximalen vollen Altersrente» = 1.5 x 12 x the monthly maximum full old-age pension, compared with the taxable income of one year."@en .

fz:I-own-child a stk:Interpretation ;
    rdfs:label "I7 Own child"@en ;
    rdfs:comment "«Kindesverhältnis im Sinne des Zivilgesetzbuches» is asked as «own child (by birth or by adoption)»."@en .

fz:I-post-compulsory a stk:Interpretation ;
    rdfs:label "I8 Post-compulsory education"@en ;
    rdfs:comment "An apprenticeship, an upper secondary school and a university are post-compulsory education («nachobligatorische Ausbildung»). The model does not check the definition of education in detail."@en .

fz:I-compulsory-school a stk:Interpretation ;
    rdfs:label "I9 Compulsory school after the 16th birthday"@en ;
    rdfs:comment "If the child still attends compulsory school after the 16th birthday, the education allowance starts at the start of the month after the month of the 16th birthday."@en .

fz:I-scope-insured a stk:Interpretation ;
    rdfs:label "I10 AHV insurance and subjection"@en ;
    rdfs:comment "The model does not ask if the applicant is compulsorily insured in the AHV and if the employer is subject to the act (Art. 11, Art. 13 para. 1, 2 and 2bis). It assumes yes. «Employed» includes employees of employers that do not pay contributions (Art. 13 para. 2)."@en .

fz:I-parameters-2026 a stk:Interpretation ;
    rdfs:label "I11 Values of 2026"@en ;
    rdfs:comment "The amounts in CHF are the values in force in 2026. The model uses them for all dates of application."@en .

fz:I-agriculture a stk:Interpretation ;
    rdfs:label "I12 Agriculture"@en ;
    rdfs:comment "Art. 18 sends persons in agriculture to the FLG. The model gives this as a next step and asks no further questions."@en .

# =========================================================================
# Parameters (values of the law that the rules need)
# =========================================================================

fz:childAllowanceMinimum a stk:Parameter ;
    rdfs:label "Minimum child allowance per month (CHF)"@en ;
    rdf:value 215 ;
    dcterms:source fz:Art5-1 ;
    stk:interpretation fz:I-parameters-2026 .

fz:educationAllowanceMinimum a stk:Parameter ;
    rdfs:label "Minimum education allowance per month (CHF)"@en ;
    rdf:value 268 ;
    dcterms:source fz:Art5-2 ;
    stk:interpretation fz:I-parameters-2026 .

fz:childAllowanceEndAge a stk:Parameter ;
    rdfs:label "Age at which the child allowance ends"@en ;
    rdf:value 16 ;
    dcterms:source fz:Art3-1-a ;
    stk:interpretation fz:I-age .

fz:childAllowanceEndAgeIncapable a stk:Parameter ;
    rdfs:label "Age at which the child allowance ends if the child is incapable of gainful work"@en ;
    rdf:value 20 ;
    dcterms:source fz:Art3-1-a ;
    stk:interpretation fz:I-age .

fz:educationAllowanceStartAge a stk:Parameter ;
    rdfs:label "Earliest age for the education allowance"@en ;
    rdf:value 15 ;
    dcterms:source fz:Art3-1-b ;
    stk:interpretation fz:I-age .

fz:compulsorySchoolAge a stk:Parameter ;
    rdfs:label "Age after which compulsory school gives the education allowance"@en ;
    rdf:value 16 ;
    dcterms:source fz:Art3-1-b ;
    stk:interpretation fz:I-age , fz:I-compulsory-school .

fz:educationAllowanceEndAge a stk:Parameter ;
    rdfs:label "Age at which the education allowance ends at the latest"@en ;
    rdf:value 25 ;
    dcterms:source fz:Art3-1-b ;
    stk:interpretation fz:I-age .

fz:minimumFullOldAgePension a stk:Parameter ;
    rdfs:label "Minimum full AHV old-age pension per month (CHF)"@en ;
    rdf:value 1260 ;
    dcterms:source fz:InfoAhvIv2026 ;
    stk:interpretation fz:I-parameters-2026 .

fz:minimumIncomeShare a stk:Parameter ;
    rdfs:label "Share of the annual minimum full old-age pension that gives the minimum income"@en ;
    rdf:value 0.5 ;
    dcterms:source fz:Art13-3 ;
    stk:interpretation fz:I-minimum-income .

fz:maximumFullOldAgePension a stk:Parameter ;
    rdfs:label "Maximum full AHV old-age pension per month (CHF)"@en ;
    rdf:value 2520 ;
    dcterms:source fz:InfoAhvIv2026 ;
    stk:interpretation fz:I-parameters-2026 .

fz:nonEmployedIncomeFactor a stk:Parameter ;
    rdfs:label "Factor on the annual maximum full old-age pension that gives the income limit for non-employed persons"@en ;
    rdf:value 1.5 ;
    dcterms:source fz:Art19-2 ;
    stk:interpretation fz:I-maximum-taxable .

