fz:SelfEmployed rdfs:label "Self-employed (not in agriculture)"@en .
fz:NonEmployed rdfs:label "Not gainfully employed"@en .
fz:Agriculture rdfs:label "Employed or self-employed in agriculture"@en .

fz:OwnChild rdfs:label "Own child (by birth or by adoption)"@en .
fz:StepChild rdfs:label "Stepchild"@en .
fz:FosterChild rdfs:label "Foster child"@en .
fz:SiblingOrGrandchild rdfs:label "Sibling or grandchild"@en .
