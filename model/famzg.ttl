# Knowledge model: family allowances for one child under the Swiss Federal Act on
# Family Allowances (FamZG, SR 836.2), version of 1 January 2026.
#
# Scope: child allowance and education allowance (federal minimum amounts).
# Out of scope: cantonal amounts, children abroad, several persons entitled for
# the same child, birth and adoption allowances, agriculture (FLG).
#
# Questions:      SHACL property shapes of the questionnaire fz:FamilyAllowanceQuestionnaire.
# Relevance:      stk:askWhen gives the shape that the answers must conform to.
# Rules:          stk:Rule shapes with one SHACL-SPARQL constraint each,
#                 with sh:message, dcterms:source and stk:outcome.
# Law values:     stk:Parameter with rdf:value and dcterms:source.
# Interpretations: stk:Interpretation, linked with stk:interpretation.
# Open points:    stk:OpenPoint, deactivated rules.

@prefix fz:      <https://software-that-knows.example/famzg#> .
@prefix stk:     <https://software-that-knows.example/vocab#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eli:     <http://data.europa.eu/eli/ontology#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .

fz: a owl:Ontology ;
    rdfs:label "Family allowances for one child (FamZG)"@en ;
    dcterms:source fz:FamZG ;
    owl:imports <https://software-that-knows.example/vocab> .

# =========================================================================
# Sources
# =========================================================================

fz:FamZG a eli:LegalResource ;
    rdfs:label "Federal Act on Family Allowances (FamZG, SR 836.2), version of 1 January 2026"@en ;
    eli:id_local "SR 836.2" ;
    rdfs:seeAlso <https://fedlex.data.admin.ch/filestore/fedlex.data.admin.ch/eli/cc/2008/51/20260101/de/html/fedlex-data-admin-ch-eli-cc-2008-51-20260101-de-html-1.html> .

fz:Art3-1-a a eli:LegalResourceSubdivision ;
    eli:is_part_of fz:FamZG ;
    rdfs:label "FamZG Art. 3 para. 1 let. a"@en ;
    dcterms:description "Kinderzulage: vom Beginn des Geburtsmonats bis zum Ende des Monats, in dem das Kind das 16. Altersjahr vollendet; bei Erwerbsunfähigkeit bis zum Ende des Monats, in dem es das 20. Altersjahr vollendet."@de ;
    rdfs:seeAlso <https://fedlex.data.admin.ch/filestore/fedlex.data.admin.ch/eli/cc/2008/51/20260101/de/html/fedlex-data-admin-ch-eli-cc-2008-51-20260101-de-html-1.html#art_3> .

fz:Art3-1-b a eli:LegalResourceSubdivision ;
    eli:is_part_of fz:FamZG ;
    rdfs:label "FamZG Art. 3 para. 1 let. b"@en ;
    dcterms:description "Ausbildungszulage: ab Beginn des Monats, in dem das Kind eine nachobligatorische Ausbildung beginnt, frühestens ab Beginn des Monats, in dem es das 15. Altersjahr vollendet; bis zum Abschluss der Ausbildung, längstens bis zum Ende des Monats, in dem es das 25. Altersjahr vollendet."@de ;
    rdfs:seeAlso <https://fedlex.data.admin.ch/filestore/fedlex.data.admin.ch/eli/cc/2008/51/20260101/de/html/fedlex-data-admin-ch-eli-cc-2008-51-20260101-de-html-1.html#art_3> .

