{
  "name": "software-that-knows",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "bun generator/generate.ts model/famzg.ttl app/src/generated",
    "dev": "bun run generate && bun --hot app/index.html",
    "build": "bun run generate && bun build app/index.html --outdir dist --minify",
    "serve": "bun e2e/serve.ts",
    "test": "bun run generate && bun test",
    "e2e": "bun run build && bun e2e/happy-path.e2e.ts",
    "typecheck": "bun run generate && tsc -p ."
  },
  "dependencies": {
    "@jsonforms/core": "^3.8.0",
    "@jsonforms/react": "^3.8.0",
    "@jsonforms/vanilla-renderers": "^3.8.0",
    "@rdfjs/data-model": "^2.1.2",
    "@rdfjs/dataset": "^2.0.3",
    "n3": "^2.13.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shacl-engine": "^1.1.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/n3": "^1.26.4",
    "@types/rdfjs__data-model": "^2.0.9",
    "@types/rdfjs__dataset": "^2.0.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2"
  },
  "patchedDependencies": {
    "shacl-engine@1.1.3": "patches/shacl-engine@1.1.3.patch"
  }
}
