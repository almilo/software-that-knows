{
  "name": "software-that-knows",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "bun generator/generate.ts app/src/generated model/vocabulary.ttl model/famzg.ttl",
    "dev": "bun run generate && bun --hot app/index.html",
    "build": "bun run generate && bun build app/index.html --outdir dist --minify",
    "serve": "bun scripts/serve.ts",
    "test": "bun run generate && bun test tests/",
    "test:e2e": "bun run build && bun test ./tests/e2e/app.e2e.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@jsonforms/core": "^3.8.0",
    "@jsonforms/react": "^3.8.0",
    "@jsonforms/vanilla-renderers": "^3.8.0",
    "@rdfjs/data-model": "^2.1.2",
    "ajv": "^8.20.0",
    "n3": "^2.13.12",
    "rdf-ext": "^2.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shacl-engine": "^1.1.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/n3": "^1.26.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2"
  }
}
